@model List<MyFirstApp.Entities.Product>
	@{
		int number = 1;
	}

	<table class="table table-striped">
		<thead>
			<tr>
				<th>sn</th>
				<th>name</th>
				<th>description</th>
				<th>unit price</th>
				<th>Qty</th>
				<th>Category Name</th>
				<th></th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var P in Model)
			{
				<tr>
					<td>@number</td>
					<td>@P.Name</td>
					<td>@P.Description</td>
					<td> &#8358;@P.UnitPrice.ToString("N")</td>
					<td>@P.Quantity</td>
					<td>@P.Category.Name</td>
					<td><a href="/products/editproduct/@P.Id">edit</a></td>
					<td><a>delete</a></td>
				</tr>
				number++;
			}
		</tbody>
	</table>
	<a href="/products/AddProduct" class="btn btn-primary">Add a product</a>
	