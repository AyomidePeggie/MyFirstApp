@model ProductModel
@{
}

<style>
	/* Main carousel styling */
	#main-carousel {
		margin-bottom: 1rem;
	}

		#main-carousel .splide__track {
			background: #f8f8f8;
			border-radius: 4px;
		}

		#main-carousel .splide__slide {
			display: flex;
			align-items: center;
			justify-content: center;
			aspect-ratio: 1;
			max-width: 100%;
			padding: 1rem;
		}

			#main-carousel .splide__slide img {
				max-width: 100%;
				max-height: 100%;
				width: auto;
				height: auto;
				object-fit: contain;
			}

	/* Thumbnail carousel styling */
	#thumbnail-carousel .splide__track {
		padding: 0.5rem 0;
	}

	#thumbnail-carousel .splide__slide {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 80px !important;
		height: 80px !important;
		margin-right: 0.5rem;
		border: 1px solid #ddd;
		border-radius: 4px;
		cursor: pointer;
		opacity: 0.6;
		transition: opacity 0.3s ease;
	}

		#thumbnail-carousel .splide__slide.is-active {
			border-color: #0066cc;
			opacity: 1;
		}

		#thumbnail-carousel .splide__slide img {
			max-width: 90%;
			max-height: 90%;
			width: auto;
			height: auto;
			object-fit: contain;
		}

	/* Form styling */
	.form-group {
		margin-bottom: 1rem;
	}

	.control-label {
		margin-bottom: 0.5rem;
	}

	/* Tags input styling */
	.tagsinput {
		border: 1px solid #ddd;
		padding: 0.5rem;
		border-radius: 4px;
		min-height: 44px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		background: #e9ecef;
		padding: 0.25rem 0.5rem;
		margin: 0.25rem;
		border-radius: 3px;
		font-size: 0.875rem;
	}

	.tag-text {
		margin-right: 0.25rem;
	}

	.tag-remove {
		border: none;
		background: none;
		color: #666;
		cursor: pointer;
		padding: 0 0.25rem;
		font-size: 1rem;
		line-height: 1;
	}

		.tag-remove:hover {
			color: #dc3545;
		}

	.tag-input {
		border: none;
		padding: 0.25rem;
		margin: 0.25rem;
		outline: none;
		min-width: 100px;
	}

		.tag-input:focus {
			outline: none;
		}

	@@media (max-width: 768px) {
		#main-carousel .splide__slide {
			aspect-ratio: 1;
		}

		#thumbnail-carousel .splide__slide {
			width: 60px !important;
			height: 60px !important;
		}
	}
</style>
<div class="container">
	<h2>Edit Product</h2>
	<div class="row">
		<div class="col-lg-6">
			<form action="@Url.Action("EditProduct","Products")" method="post">
				<div class="form-horizontal">
					<input type="hidden" name="Id" value="@Model.Id" />
					<div class="form-group">
						<label class="control-label">Name</label>
						<input type="text" class="form-control" name="Name" id="Name" value="@Model.Name" />
						<span class="text-danger">@Html.ValidationMessage("Name")</span>
					</div>
					<div class="form-group">
						<label class="control-label">Description</label>
						<input type="text" class="form-control" name="Description" id="Description" value="@Model.Description"/>
						<span class="text-danger">@Html.ValidationMessage("Description")</span>
					</div>

					<div class="form-group">
						<label class="control-label">Quantity</label>
						<input type="text" class="form-control" name="Quantity" id="Quantity" value="@Model.Quantity" />
						<span class="text-danger">@Html.ValidationMessage("Quantity")</span>
					</div>

					<div class="form-group">
						<label class="control-label">UnitPrice</label>
						<input type="text" class="form-control" name="UnitPrice" id="UnitPrice" value="@Model.UnitPrice" />
						<span class="text-danger">@Html.ValidationMessage("UnitPrice")</span>
					</div>
					<div class=" form-group">
						<label>Category</label>
						<select id="SelectedCategoryId" name="SelectedCategoryId" class="form-control">
							<option>Select a Category</option>
							@foreach (var category in Model.Categories)
							{
								<option value="@category.Value" selected="@Model.SelectedCategoryId">
									@category.Text
								</option>
							}
						</select>
					</div>
					<div class="form-group">
						<input type="submit" value="Save" class="btn btn-primary  form-control" />
					</div>
				</div>


			</form>
		</div>
	</div>
</div>