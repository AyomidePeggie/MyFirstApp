@model List<SelectListItem>
@{
}
<div class="container">
	<h2>Add Product</h2>
	<div class="row">
    <div class="col-lg-6">
		<form action="@Url.Action("AddProduct","Products")" method="post">
			<div class="form-horizontal">
				<input type="hidden" name="Id" value="0"/>
				<div class="form-group">
						<label class="control-label">Name</label>
						<input type="text" class="form-control" name="Name" id="Name" />
					<span class="text-danger">@Html.ValidationMessage("Name")</span>
				</div>
					<div class="form-group">
						<label class="control-label">Description</label>
						<input type="text" class="form-control" name="Description" id="Description" />
						<span class="text-danger">@Html.ValidationMessage("Description")</span>
					</div>

					<div class="form-group">
						<label class="control-label">Quantity</label>
						<input type="text" class="form-control" name="Quantity" id="Quantity" />
						<span class="text-danger">@Html.ValidationMessage("Quantity")</span>
					</div>

					<div class="form-group">
						<label class="control-label">UnitPrice</label>
						<input type="text" class="form-control" name="UnitPrice" id="UnitPrice" />
						<span class="text-danger">@Html.ValidationMessage("UnitPrice")</span>
					</div>
					<div class=" form-group">
						<label>Category</label>
						<select id="SelectedCategoryId" name="SelectedCategoryId" class="form-control">
							<option>Select a Category</option>
							@foreach(var category in Model)
							{
								<option value="@category.Value">
									@category.Text
								</option>
							}
						</select>
					</div>
					<div class="form-group">
						<input type="submit" value="Save" class="btn btn-primary  form-control"/>
					</div>
			</div>


		</form>
	</div>
	</div>
</div>