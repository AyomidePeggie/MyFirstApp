@model List<MyFirstApp.Entities.Product>
@{
	int number = 1;
}

<table class="table table-striped"> 
	<thead>
		<tr>
			<th>sn</th>
			<th>name</th>
			<th>description</th>
			<th>unit price</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var P in Model)
		{
			<tr>
				<td>@number</td>
				<td>@P.Name</td>
				<td>@P.Description</td>
				<td> &#8358;@P.UnitPrice.ToString("N")</td>
			</tr>
			number++;
		}
	</tbody>
</table>